# Supabaseプロジェクトの Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# シード投入時のみ使用（RLSをバイパスして書き込むため）。ブラウザには絶対に露出させない。
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# scripts/seed.ts が e-Stat API から市町村統計を再取得する場合に使用（任意）。
# https://www.e-stat.go.jp/api/ で取得したAppIdを設定する。未設定でも supabase/seed.sql の投入だけなら不要。
ESTAT_APP_ID=

# AI分析機能を実装する際に使用（今回のフェーズでは未使用）。
OPENAI_API_KEY=
